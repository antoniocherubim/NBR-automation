{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nbr12721.local/schemas/normative-reference-index-v1.schema.json",
  "title": "Normative reference index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "references"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "source": {
      "$ref": "#/$defs/normative_source"
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/normative_reference"
      }
    }
  },
  "$defs": {
    "iso_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reference_id": {
      "type": "string",
      "pattern": "^nbr12721:2006:vc3:[a-z0-9]+(?:[-.:][a-z0-9]+)*$"
    },
    "errata_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "date", "note"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "date": {
          "$ref": "#/$defs/iso_date"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 280
        }
      }
    },
    "normative_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "organization",
        "designation",
        "year",
        "edition",
        "corrected_version",
        "publication_date",
        "corrected_version_date",
        "errata",
        "logical_path",
        "sha256",
        "media_type",
        "size_bytes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "const": "abnt-nbr-12721-2006-vc3"
        },
        "organization": {
          "type": "string",
          "const": "ABNT"
        },
        "designation": {
          "type": "string",
          "const": "NBR 12721"
        },
        "year": {
          "type": "integer",
          "const": 2006
        },
        "edition": {
          "type": "string",
          "const": "second"
        },
        "corrected_version": {
          "type": "integer",
          "const": 3
        },
        "publication_date": {
          "type": "string",
          "const": "2006-08-28"
        },
        "corrected_version_date": {
          "type": "string",
          "const": "2021-01-19"
        },
        "errata": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {"allOf": [{"$ref": "#/$defs/errata_record"}, {"properties": {"label": {"const": "Errata 1"}, "date": {"const": "2007-01-29"}}}]},
            {"allOf": [{"$ref": "#/$defs/errata_record"}, {"properties": {"label": {"const": "Errata 2"}, "date": {"const": "2007-04-09"}}}]},
            {"allOf": [{"$ref": "#/$defs/errata_record"}, {"properties": {"label": {"const": "Errata 3"}, "date": {"const": "2021-01-19"}}}]}
          ],
          "items": false
        },
        "logical_path": {
          "type": "string",
          "const": "inputs/normativa/ABNT NBR 12721-2006.pdf"
        },
        "sha256": {
          "type": "string",
          "const": "76b3c72fd5934867305b2440c3af66ef79004c07496c436095516c3afdc05674"
        },
        "media_type": {
          "type": "string",
          "const": "application/pdf"
        },
        "size_bytes": {
          "type": "integer",
          "const": 1208230
        }
      }
    },
    "printed_page": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "label"],
          "properties": {
            "kind": {
              "type": "string",
              "const": "arabic"
            },
            "label": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "label"],
          "properties": {
            "kind": {
              "type": "string",
              "const": "roman"
            },
            "label": {
              "type": "string",
              "pattern": "^[ivxlcdm]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason"],
          "properties": {
            "kind": {
              "type": "string",
              "const": "absent"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
          "pattern": "\\S",
              "maxLength": 280
            }
          }
        }
      ]
    },
    "page_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pdf_page", "printed_page"],
      "properties": {
        "pdf_page": {
          "type": "integer",
          "minimum": 1
        },
        "printed_page": {
          "$ref": "#/$defs/printed_page"
        }
      }
    },
    "normative_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "section",
        "locator",
        "reference_type",
        "formalization_state",
        "description",
        "edition_notes",
        "cross_references",
        "authority_refs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/reference_id"
        },
        "source_id": {
          "type": "string",
          "const": "abnt-nbr-12721-2006-vc3"
        },
        "section": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "locator": {
          "$ref": "#/$defs/page_locator"
        },
        "reference_type": {
          "type": "string",
          "enum": [
            "definition_classification",
            "measurement_delimitation",
            "calculation_distribution",
            "applicability_condition",
            "form_table"
          ]
        },
        "formalization_state": {
          "type": "string",
          "enum": ["indexed", "formalized", "implemented"]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 280
        },
        "edition_notes": {
          "type": "string",
          "maxLength": 280
        },
        "cross_references": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference_id"
          }
        },
        "authority_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference_id"
          }
        },
        "formal_artifact_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "implementation_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "formalization_state": {
                "const": "indexed"
              }
            },
            "required": ["formalization_state"]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["formal_artifact_ref"]
                },
                {
                  "required": ["implementation_ref"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "formalization_state": {
                "const": "formalized"
              }
            },
            "required": ["formalization_state"]
          },
          "then": {
            "required": ["formal_artifact_ref"],
            "not": {
              "required": ["implementation_ref"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "formalization_state": {
                "const": "implemented"
              }
            },
            "required": ["formalization_state"]
          },
          "then": {
            "required": ["formal_artifact_ref", "implementation_ref"]
          }
        }
      ]
    }
  }
}
